# 个人开发平台环境变量（两步启动的第 1 步）
# 复制成 .env 再填：cp .env.example .env
# .env 不进仓库（.gitignore 已排除），只填你自己的值，不要把真口令提交。

# 必填：登录口令（登录用户名见下一行；口令不能为空）
DEV_PLATFORM_PASSWORD=换成你自己的口令

# 可选：登录用户名，默认 li
DEV_PLATFORM_USER=li

# 可选：应用监听地址与端口，默认 127.0.0.1:3001（只绑内网，nginx 对外）
HOST=127.0.0.1
PORT=3001

# 可选：是否让启动脚本顺带装 nginx（默认 0，只起应用）
# 设为 1 时，启动脚本会尝试把 deploy/dev-platform.conf 装到 nginx 并 reload；
# 本机没有 nginx 或没有 sudo 权限时只警告，不影响应用启动。
NGINX_ENABLED=0

# 可选：有域名时填这里，nginx 配置里的 server_name 会换成它；没域名留空
DOMAIN=
